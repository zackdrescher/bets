# Copy to .env and fill in. NEVER commit .env or real keys.

# Environment gate. Anything other than "prod" (incl. unset) => demo. Fail-closed.
KALSHI_ENV=demo

# Kalshi API credentials. Keep DEMO and PROD key sets separate.
# Demo (paper) credentials:
KALSHI_DEMO_API_KEY_ID=
KALSHI_DEMO_PRIVATE_KEY_PATH=./secrets/kalshi_demo_key.pem

# Prod credentials (only loaded when KALSHI_ENV=prod):
KALSHI_PROD_API_KEY_ID=
KALSHI_PROD_PRIVATE_KEY_PATH=./secrets/kalshi_prod_key.pem

# Local store
BETS_DB_PATH=./bets.duckdb

# Sizing / risk config
BETS_BANKROLL_CENTS=100000        # $1,000.00 bankroll, in cents
BETS_KELLY_FRACTION=0.25          # quarter Kelly
BETS_EDGE_THRESHOLD=0.05          # minimum |q - p| to act
BETS_MAX_ORDER_CENTS=5000         # per-order spend cap ($50.00)
BETS_MAX_DAILY_CENTS=20000        # per-day spend cap ($200.00)
